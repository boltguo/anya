{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anya Configuration",
  "description": "Configuration file for the Anya AI Agent. Place at ~/.anya/config.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "provider": {
      "type": "object",
      "description": "LLM provider configuration (Codex backend).",
      "properties": {
        "model": { "type": "string", "default": "gpt-5.4" },
        "max_retries": { "type": "integer", "default": 3 },
        "context_window": { "type": "integer", "default": 1000000 },
        "compress_threshold": { "type": "number", "default": 0.8, "minimum": 0, "maximum": 1 },
        "max_history_messages": { "type": "integer", "default": 200 },
        "max_react_loops": { "type": "integer", "default": 20 }
      }
    },
    "gemini": {
      "type": "object",
      "properties": {
        "api_key": { "type": "string", "description": "Gemini API key (https://aistudio.google.com/)." },
        "vision_model": { "type": "string", "default": "gemini-3-flash-preview" }
      }
    },
    "web_search": {
      "type": "object",
      "description": "Tavily web search.",
      "properties": {
        "api_key": { "type": "string" },
        "max_results": { "type": "integer", "default": 5 }
      }
    },
    "azure": {
      "type": "object",
      "description": "Azure Speech (TTS + pronunciation assessment).",
      "properties": {
        "speech_key": { "type": "string" },
        "speech_region": { "type": "string", "default": "eastasia" }
      }
    },
    "stt": {
      "type": "object",
      "description": "Speech-to-text (Groq Whisper for inbound voice).",
      "properties": {
        "groq_api_key": { "type": "string" },
        "model": { "type": "string", "default": "whisper-large-v3-turbo" }
      }
    },
    "tts": {
      "type": "object",
      "properties": {
        "voice": { "type": "string", "default": "en-US-AriaNeural" },
        "rate": { "type": "string", "default": "+0%" }
      }
    },
    "telegram": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "bot_token": { "type": "string" },
        "allowed_user_ids": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "cron": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "tick_seconds": { "type": "integer", "default": 60, "minimum": 10 },
        "timezone": { "type": "string", "default": "UTC" },
        "default_platform": { "type": "string", "enum": ["telegram"], "default": "telegram" },
        "default_chat_id": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Directories the agent can access. Paths outside this set are denied. Supports ~ for home."
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "show_tool_calls": { "type": "boolean", "default": true }
      }
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "profile_done": { "type": "boolean", "default": false },
        "placement_done": { "type": "boolean", "default": false }
      }
    }
  }
}
