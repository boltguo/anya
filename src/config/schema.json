{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anya Configuration",
  "description": "Configuration file for the Anya AI Agent. Place at ~/.anya/config.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor auto-completion."
    },
    "version": {
      "type": "string",
      "description": "Configuration version, should match the Anya version."
    },
    "provider": {
      "type": "object",
      "description": "LLM provider configuration.",
      "properties": {
        "model": {
          "type": "string",
          "description": "Primary model name (e.g. gpt-5.4).",
          "default": "gpt-5.4"
        },
        "max_retries": {
          "type": "integer",
          "description": "Max retries on transient failures.",
          "default": 3
        },
        "context_window": {
          "type": "integer",
          "description": "Model context window size in tokens.",
          "default": 1000000
        },
        "compress_threshold": {
          "type": "number",
          "description": "Context usage ratio (0.0-1.0) to trigger compression.",
          "default": 0.8
        },
        "max_history_messages": {
          "type": "integer",
          "description": "Max number of messages to send to LLM context.",
          "default": 200
        },
        "max_react_loops": {
          "type": "integer",
          "description": "Maximum ReAct loop iterations to prevent infinite loops.",
          "default": 20
        }
      }
    },
    "gemini": {
      "type": "object",
      "description": "Gemini API Configuration",
      "properties": {
        "api_key": {
          "type": "string",
          "description": "API key for the Gemini provider. Get from https://aistudio.google.com/"
        },
        "vision_model": {
          "type": "string",
          "description": "Gemini vision model name.",
          "default": "gemini-3-flash-preview"
        }
      }
    },
    "web_search": {
      "type": "object",
      "description": "Web search (Tavily).",
      "properties": {
        "api_key": {
          "type": "string",
          "description": "API key for Tavily."
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of search results.",
          "default": 5
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security settings for file access.",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Directories the agent can access without approval. Supports ~ for home."
        },
        "fence_mode": {
          "type": "string",
          "enum": ["ask", "deny", "allow"],
          "description": "'ask' prompts user, 'deny' blocks, 'allow' permits all.",
          "default": "deny"
        }
      }
    },
    "telegram": {
      "type": "object",
      "description": "Telegram bot configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "bot_token": {
          "type": "string",
          "description": "Telegram bot token from @BotFather."
        },
        "allowed_user_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Telegram user IDs allowed to interact with the bot."
        }
      }
    },
    "cron": {
      "type": "object",
      "description": "Scheduled task system. Jobs are stored in ~/.anya/cron/jobs.json and can be managed via CLI or the cron tool.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Start the background scheduler with the Telegram gateway.",
          "default": false
        },
        "tick_seconds": {
          "type": "integer",
          "description": "Scheduler polling interval in seconds.",
          "default": 60,
          "minimum": 10
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone used to compute cron expressions.",
          "default": "UTC"
        },
        "default_chat_id": {
          "type": "string",
          "description": "Default Telegram chat ID for cron jobs created outside a chat context.",
          "default": ""
        }
      }
    },
    "stt": {
      "type": "object",
      "description": "Speech-to-text (Groq Whisper).",
      "properties": {
        "groq_api_key": {
          "type": "string",
          "description": "Groq API key. Get from https://console.groq.com/"
        },
        "model": {
          "type": "string",
          "description": "Groq Whisper model name.",
          "default": "whisper-large-v3-turbo"
        }
      }
    },
    "tts": {
      "type": "object",
      "description": "Text-to-speech (Azure Neural).",
      "properties": {
        "voice": {
          "type": "string",
          "description": "Azure Neural voice name.",
          "default": "en-US-AriaNeural"
        }
      }
    },
    "azure": {
      "type": "object",
      "description": "Azure Speech service (TTS + pronunciation).",
      "properties": {
        "speech_key": {
          "type": "string",
          "description": "Azure Speech subscription key."
        },
        "speech_region": {
          "type": "string",
          "description": "Azure Speech region.",
          "default": "eastasia"
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "UI display settings.",
      "properties": {
        "show_tool_calls": {
          "type": "boolean",
          "description": "Show tool call details in the terminal.",
          "default": true
        }
      }
    },
    "onboarding": {
      "type": "object",
      "description": "Onboarding completion flags.",
      "properties": {
        "profile_done": { "type": "boolean", "default": false },
        "placement_done": { "type": "boolean", "default": false }
      }
    }
  }
}
